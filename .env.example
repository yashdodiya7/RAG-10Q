# Copy to .env and fill in. .env is git-ignored.

ENVIRONMENT=development
DEBUG=false

# LLM (extraction, entity-resolution judge, answers)
PRIMARY_LLM=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings (local, CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# API
API_HOST=0.0.0.0
API_PORT=8000

# Neo4j (docker compose). Defaults are 7474/7687; on Windows these are often
# reserved by Hyper-V/WSL - then use 17474/17687 and the matching NEO4J_URI.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag10q-dev-password
